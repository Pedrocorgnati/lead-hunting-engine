# ============================================
# VARIAVEIS DE AMBIENTE - LEAD HUNTING ENGINE
# ============================================
# Copie este arquivo para .env e preencha os valores
# Este arquivo é seguro para versionar (valores são placeholders)
# ============================================

# ────────────────────────────────────────────
# AMBIENTE
# ────────────────────────────────────────────
NODE_ENV=development

# ────────────────────────────────────────────
# APLICACAO
# ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────
# BANCO DE DADOS - PostgreSQL (Supabase)
# ────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres

# ────────────────────────────────────────────
# SUPABASE (Backend-as-a-Service)
# ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_WEBHOOK_SECRET=sua-webhook-secret-aqui

# ────────────────────────────────────────────
# SEGURANCA
# ────────────────────────────────────────────
# Gere com: openssl rand -hex 32
ENCRYPTION_KEY=gere-com-openssl-rand-hex-32

# Gere com: openssl rand -base64 32
JWT_SECRET=gere-com-openssl-rand-base64-32

# ────────────────────────────────────────────
# AI / LLM
# ────────────────────────────────────────────
ANTHROPIC_API_KEY=sua-chave-anthropic-aqui
OPENAI_API_KEY=sk-proj-seu-id-aqui
KIMI_API_KEY=sk-kimi-sua-chave-aqui

# ────────────────────────────────────────────
# EMAIL
# ────────────────────────────────────────────
RESEND_API_KEY=re_seu-id-aqui

# ────────────────────────────────────────────
# TRIGGER.DEV (OPTIONAL)
# ────────────────────────────────────────────
TRIGGER_SECRET_KEY=seu-trigger-secret-aqui

# ────────────────────────────────────────────
# SOCIAL GRAPH APIs (OPTIONAL)
# ────────────────────────────────────────────
INSTAGRAM_GRAPH_TOKEN=seu-instagram-long-lived-token
FACEBOOK_GRAPH_TOKEN=seu-facebook-page-access-token

# ────────────────────────────────────────────
# CRON JOBS
# ────────────────────────────────────────────
# Gere com: openssl rand -hex 32
# CRON_SECRET e o nome canonico (lido por todos os cron handlers).
# CRON_SECRET_KEY e mantido como fallback legado.
CRON_SECRET=gere-com-openssl-rand-hex-32
CRON_SECRET_KEY=gere-com-openssl-rand-hex-32

# ────────────────────────────────────────────
# HEADLESS SCRAPER
# ────────────────────────────────────────────
# URL do proxy residencial: http://user:pass@host:port
RESIDENTIAL_PROXY_URL=
# Desativar headless em emergencia: false desabilita completamente
HEADLESS_ENABLED=true

# ────────────────────────────────────────────
# FEATURE FLAGS (Fase 2 — ADR-0042)
# ────────────────────────────────────────────
# Provider de feature flags. Valores aceitos: local | noop
#   local: Postgres-backed (default; ler ADR-0042). Requer migration add_feature_flags aplicada.
#   noop:  todos os reads retornam null -> default (usar em testes ou ambientes congelados).
FEATURE_FLAGS_PROVIDER=local
# Reservados para futura migracao a SaaS. Deixar vazios enquanto provider = local.
FEATURE_FLAGS_API_KEY=
FEATURE_FLAGS_CLIENT_KEY=
FEATURE_FLAGS_HOST=

# ────────────────────────────────────────────
# INTEGRACAO BUDGETFLOW (A18 /exportar/budgetflow)
# ────────────────────────────────────────────
# Sem BUDGETFLOW_API_URL o push completa em modo manual-download (payload
# gerado para baixar; nada e enviado a sistema externo).
BUDGETFLOW_API_URL=
BUDGETFLOW_API_TOKEN=

# ────────────────────────────────────────────
# WEB PUSH (canal push de notificacoes)
# ────────────────────────────────────────────
# Gerar par VAPID: npx web-push generate-vapid-keys
# Sem as chaves o canal push degrada para email/in-app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# ────────────────────────────────────────────
# PROVIDERS DE ENRIQUECIMENTO (opcionais — enrichers pulam com warn sem eles)
# ────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
SERPAPI_KEY=
PHANTOMBUSTER_IG_AGENT_ID=
TRIPADVISOR_API_KEY=
GOOGLE_ADS_API_KEY=
META_ADS_API_KEY=
# Flags de fontes stub (manter false ate implementacao real)
RECLAME_AQUI_ENABLED=false
SINTEGRA_ENABLED=false
# Pool de proxies residenciais (separados por virgula)
RESIDENTIAL_PROXY_POOL=

# ────────────────────────────────────────────
# EMAIL (Resend — remetente/reply-to opcionais)
# ────────────────────────────────────────────
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# ────────────────────────────────────────────
# OPERACAO
# ────────────────────────────────────────────
# Banner/gate global de manutencao (middleware)
MAINTENANCE_MODE=false
# Lockout de autenticacao (defaults seguros no codigo)
AUTH_LOCKOUT_THRESHOLD=
AUTH_LOCKOUT_MAX_DELAY_MS=
AUTH_LOCKOUT_COOLDOWN_MIN=
# Dedup (thresholds 0-100 e janela de undo em dias)
DEDUP_AUTO_MERGE_MIN=
DEDUP_PENDING_REVIEW_MIN=
DEDUP_UNDO_WINDOW_DAYS=
# TTL de convites em dias
INVITE_TTL_DAYS=
# Override de feature flag por env (false desabilita FLAG_<NAME> overrides)
FLAG_OVERRIDE_ENABLED=
# Sentry client-side
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

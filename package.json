{
  "name": "lead-hunting-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||''; if(!ua.startsWith('pnpm')){console.error('[lead-hunting-engine] Use pnpm install (NOT npm/yarn): mixed lockfiles corrupt node_modules. Canonical lockfile: pnpm-lock.yaml'); process.exit(1);}\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "jest --config jest.config.ts",
    "test:integration": "jest --config jest.integration.config.ts --runInBand",
    "test:integration:watch": "jest --config jest.integration.config.ts --watch",
    "test:smoke": "jest --config jest.integration.config.ts --runInBand --testPathPatterns='collect-leads.smoke'",
    "test:e2e": "playwright test",
    "smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:all": "jest --config jest.config.ts && jest --config jest.integration.config.ts --runInBand",
    "seed:dev": "tsx prisma/seed/dev.ts",
    "seed:test": "tsx prisma/seed/test.ts",
    "seed:prod": "tsx prisma/seed/prod.ts",
    "docker:dev": "docker compose up",
    "docker:dev:build": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:prod:build": "docker build -t lead-hunting-engine:latest .",
    "setup": "./scripts/bootstrap.sh",
    "reset": "./scripts/bootstrap.sh --reset",
    "openapi:generate": "tsx scripts/generate-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed/dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@scalar/api-reference-react": "^0.9.37",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "@swc/helpers": "^0.5.19",
    "@tanstack/react-table": "^8.21.3",
    "@trigger.dev/sdk": "^4.4.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "dotenv": "^17.3.1",
    "imapflow": "^1.4.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "mailparser": "^3.9.9",
    "next": "16.2.1",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "openai": "^6.32.0",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "resend": "^6.9.4",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "string-similarity": "^4.0.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zxcvbn": "^4.4.2"

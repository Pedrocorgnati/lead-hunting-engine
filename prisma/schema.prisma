// TASK-15 intake-review (CL-173): fila local como fallback ao trigger.dev.
// Semantica:
//  - `kind` identifica o job (ex.: 'export', 'enrichment').
//  - `payloadHash` = sha256(kind + canonical(payload)) para idempotencia.
//  - `status`: PENDING -> LEASED -> DONE | FAILED.
//  - Lease via `UPDATE ... WHERE id = ANY (SELECT ... FOR UPDATE SKIP LOCKED ...)`
//    — suporta multiplas replicas sem duplo processamento.
//  - Retry expo backoff: attempts = 0..3; runAt = now + 2^attempts min.
model LocalQueueJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        String    @db.VarChar(80)
  payloadHash String    @map("payload_hash") @db.VarChar(64)
  payload     Json
  status      String    @default("PENDING") @db.VarChar(20)
  attempts    Int       @default(0)
  leasedUntil DateTime? @map("leased_until")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  runAt       DateTime  @default(now()) @map("run_at")

  @@unique([kind, payloadHash])
  @@index([status, runAt])
  @@map("local_queue_jobs")
}

// Task 52 / A18: pushes do fluxo dedicado BudgetFlow (/exportar/budgetflow).
// Persistido em DB (multi-instancia safe; substitui o Map em memoria).
// `status`: PENDING -> PROCESSING -> COMPLETED | FAILED (string, padrao
// LocalQueueJob). Processamento via local-queue kind 'budgetflow-push' com
// execucao inline best-effort no POST (worker idempotente por status guard).
model BudgetFlowPush {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  campaignId   String   @map("campaign_id") @db.VarChar(120)
  budget       Decimal  @db.Decimal(14, 2)
  currency     String   @db.VarChar(3)
  note         String?
  leadIds      String[] @default([]) @map("lead_ids") @db.Uuid
  payload      Json?
  status       String   @default("PENDING") @db.VarChar(20)
  attempts     Int      @default(0)
  delivered    Boolean  @default(false)
  deliveryMode String?  @map("delivery_mode") @db.VarChar(30)
  result       Json?
  error        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@map("budget_flow_pushes")
}

// ─────────────────────────────────────────
// FEATURE FLAGS — module-16 (Fase 2)
// ADR-0042: provider local Postgres-backed
// ─────────────────────────────────────────

model FeatureFlag {
  id                 String   @id @default(cuid())
  /// Nome canonico `dominio.modulo.sub_feature` (snake_case, 3 partes).
  name               String   @unique @db.VarChar(120)
  description        String?  @db.VarChar(500)
  ownerModule        String   @map("owner_module") @db.VarChar(100)
  /// Valor default quando nenhum env override existe. JSON: bool|number|string|object.
  defaultValue       Json     @map("default_value")
  /// Tags para filtro (ex: ["billing", "canary"]).
  tags               String[] @default([])
  /// Mapa env -> valor JSON. Suporta payload `{rollout_pct, target_value, fallback_value}`.
  envValues          Json     @default("{}") @map("env_values")
  /// Id do provider externo (LaunchDarkly/GrowthBook). Vazio enquanto local.
  externalProviderId String?  @map("external_provider_id") @db.VarChar(200)
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  createdBy          String   @map("created_by") @db.VarChar(64)

  changes            FeatureFlagChange[]
  usages             FeatureFlagUsage[]

  @@index([ownerModule])
  @@index([tags])
  @@index([archivedAt])
  @@map("feature_flags")
}

model FeatureFlagChange {
  id             String      @id @default(cuid())
  flag           FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  flagId         String      @map("flag_id")
  /// Ambiente afetado: development | preview | production.
  env            String      @db.VarChar(20)
  /// Tipo de mudanca: created | updated_default | env_value_set | env_value_cleared | metadata_updated | deleted
  kind           String      @db.VarChar(40)
  beforeValue    Json        @map("before_value")
  afterValue     Json        @map("after_value")
  reason         String      @db.VarChar(500)
  changedBy      String      @map("changed_by") @db.VarChar(64)
  changedByEmail String      @map("changed_by_email") @db.VarChar(180)
  ipAddress      String      @map("ip_address") @db.VarChar(64)
  userAgent      String?     @map("user_agent") @db.VarChar(500)
  correlationId  String?     @map("correlation_id") @db.VarChar(100)
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([flagId, createdAt])
  @@index([changedBy, createdAt])
  @@index([env, createdAt])
  @@map("feature_flag_changes")
}

model FeatureFlagUsage {
  id        String      @id @default(cuid())
  flag      FeatureFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  flagId    String      @map("flag_id")
  filePath  String      @map("file_path") @db.VarChar(400)
  lineStart Int         @map("line_start")
  lineEnd   Int         @map("line_end")
  snippet   String      @db.VarChar(500)
  scannedAt DateTime    @default(now()) @map("scanned_at")

  @@index([flagId])
  @@index([filePath])
  @@map("feature_flag_usages")
}

